# --- Backend ---
# Connection string cho Supabase PostgreSQL (Transaction Pooler).
# Format Npgsql key-value (khong dung postgresql://...).
ConnectionStrings__DefaultConnection="Host=aws-0-<REGION>.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.<REF>;Password=<PASSWORD>;SSL Mode=Require;Trust Server Certificate=true"

# Comma-separated allowed origins for CORS (Vercel FE)
Cors__AllowedOrigins__0="http://localhost:3000"
Cors__AllowedOrigins__1="https://*.vercel.app"
Cors__AllowedOrigins__2="https://<your-vercel-domain>.vercel.app"

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:10000

# --- Frontend ---
NEXT_PUBLIC_API_URL="https://<your-render-backend>.onrender.com"
